# ค่าการเชื่อมต่อฐานข้อมูลของ Single-Use Sticker
# ใส่รหัสผ่านของ login singleuse_app (ที่ตั้งตอนรัน database\00_create_database.sql)
# ในบรรทัด DB_PASSWORD แทนคำว่า CHANGE_ME โดยเก็บเครื่องหมายคำพูดไว้
# (โปรแกรมจะไม่ยอมเปิดถ้าบรรทัดนั้นยังเป็นค่าตัวอย่าง)

# เครื่องที่ติดตั้ง SQL Server — ถ้าเป็นเครื่องเดียวกับเครื่องนี้ใช้ localhost
DB_SERVER=localhost
DB_PORT=1433
# ถ้า SQL Server เป็น instance ที่มีชื่อ (เช่น SQLEXPRESS) และ service "SQL Server Browser" เปิดอยู่
# ลบ # หน้าบรรทัดล่างแล้วใส่ชื่อ instance แทนการใช้ DB_PORT ได้
# DB_INSTANCE=SQLEXPRESS
DB_USER=singleuse_app
DB_PASSWORD="CHANGE_ME"
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true

# port ของหน้าเว็บ — เครื่องนี้เปิด http://localhost:3002 / เครื่องอื่นเปิด http://<IP เครื่องนี้>:3002
PORT=3002
